@page "{id:int}"
@model proyecto.Pages.PaymentHistoryModel
@{
    ViewData["Title"] = "Historial de Pagos";
}

<div class="max-w-3xl mx-auto p-6">
    <h2 class="text-2xl font-bold mb-4">Historial de pagos - @Model.Subscription?.ServiceName</h2>
    <div class="mb-4 text-sm text-slate-500">
        <span>Periodo: <strong>@Model.Subscription?.Periodo</strong></span>
        <span class="mx-4">|</span>
        <span>Descripción: <strong>@Model.Subscription?.Description</strong></span>
    </div>

    @if (Model.Payments == null || !Model.Payments.Any())
    {
        <p>No hay pagos registrados para esta suscripción.</p>
    }
    else
    {
        <table class="w-full text-left border-collapse">
            <thead>
                <tr>
                    <th class="p-2">Fecha</th>
                    <th class="p-2">Monto</th>
                    <th class="p-2">Periodo</th>
                    <th class="p-2">Descripción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Payments)
                {
                    <tr>
                        <td class="p-2">@p.Date.ToShortDateString()</td>
                        <td class="p-2">@p.Amount.ToString("C2")</td>
                        <td class="p-2">@Model.Subscription?.Periodo</td>
                        <td class="p-2">@Model.Subscription?.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="mt-6">
        <a asp-page="Index" class="text-sm text-indigo-600">&larr; Volver</a>
    </div>
</div>
