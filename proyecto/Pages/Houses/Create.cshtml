@page
@model proyecto.Pages.Houses.CreateModel
@{
    ViewData["Title"] = "Nueva Casa";
}

<div class="max-w-lg mx-auto p-6">
    <h2 class="text-2xl font-bold mb-4">Crear nueva Casa</h2>

    <form method="post" class="space-y-4">
        <div>
            <label class="block text-sm font-medium">Nombre</label>
            <input asp-for="Name" class="w-full px-4 py-2 border rounded" />
        </div>

        <div class="flex justify-end">
            <a asp-page="/Index" class="mr-4 text-sm text-gray-600">Cancelar</a>
            <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded">Crear</button>
        </div>
    </form>
</div>
