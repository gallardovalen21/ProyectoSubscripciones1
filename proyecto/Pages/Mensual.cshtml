@page
@model MensualModel

<form method="get" class="mb-4 flex items-center gap-3">
    <label class="font-medium">Año:</label>
    <select name="year" class="px-3 py-2 border rounded" onchange="this.form.submit()">
        @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year + 1; y++)
        {
            <option value="@y" selected="@(y == Model.Year)">@y</option>
        }
    </select>

    <label class="font-medium">Mes:</label>
    <select name="month" class="px-3 py-2 border rounded" onchange="this.form.submit()">
        @for (int m = 1; m <= 12; m++)
        {
            var name = new DateTime(Model.Year, m, 1).ToString("MMMM", System.Globalization.CultureInfo.GetCultureInfo("es-ES"));
            <option value="@m" selected="@(m == Model.Month)">@name</option>
        }
    </select>

    <label class="font-medium">Casa:</label>
    <select name="houseId" class="px-3 py-2 border rounded" onchange="this.form.submit()">
        <option value="" selected="@(Model.HouseId == null)">Todas</option>
        @foreach (var h in Model.Houses)
        {
            <option value="@h.Id" selected="@(Model.HouseId == h.Id)">@h.Name</option>
        }
    </select>

    <button type="submit" class="px-4 py-2 border rounded-md bg-white">Filtrar</button>
</form>

<h2>Gastos de @Model.MesNombre</h2>

<div style="max-width: 280px; margin: 0 auto;">
    <a asp-page="Mensual"
       asp-route-year="@Model.PrevYear"
       asp-route-month="@Model.PrevMonth"
       asp-route-houseId="@Model.HouseId">⬅</a>

    <strong>Total del mes: $ @Model.TotalMes.ToString("N2")</strong>

    <a asp-page="Mensual"
       asp-route-year="@Model.NextYear"
       asp-route-month="@Model.NextMonth"
       asp-route-houseId="@Model.HouseId">➡</a>
</div>

<br />

<div style="max-width: 580px; margin: 0 auto;">
    <canvas id="pieChart"></canvas>
</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const labels = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(Model.Labels)
        );

    const values = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(Model.Values)
        );

    new Chart(document.getElementById('pieChart'), {
        type: 'pie',
        data: {
            labels: labels,
            datasets: [{
                data: values
            }]
        },
        options: {
            responsive: true
        }
    });
</script>
